# HTTP Server Configuration
# -------------------------
# HTTP server binding address
HTTP_ADDRESS=0.0.0.0
# HTTP server port
HTTP_PORT=8080
# HTTP idle timeout in seconds
HTTP_IDLE_TIMEOUT=120
# HTTP read timeout in seconds
HTTP_READ_TIMEOUT=120
# HTTP write timeout in seconds
HTTP_WRITE_TIMEOUT=120

# Handler Configuration
# ---------------------
# Maximum file size for upload handler in bytes
HANDLER_MAX_FILE_SIZE=10240

# Logging Configuration
# ---------------------
# Logging level
LOG_LEVEL=info

# MinIO Configuration
# -------------------
# MinIO root username
MINIO_ROOT_USER=minioadmin
# MinIO root password
MINIO_ROOT_PASSWORD=minioadmin
# MinIO default buckets (comma-separated)
MINIO_DEFAULT_BUCKETS=mybucket

# CouchDB Configuration
# ---------------------
# CouchDB admin username
COUCHDB_USER=admin
# CouchDB admin password
COUCHDB_PASSWORD=password
# CouchDB secret key
COUCHDB_SECRET=mysecret
# CouchDB node name
COUCHDB_NODENAME=couchdb@localhost

# Redis Configuration
# -------------------
# Redis password
REDIS_PASSWORD=redispassword
# Redis append-only file persistence
REDIS_APPENDONLY=yes
